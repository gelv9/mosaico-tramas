# Copiá este archivo a .env y ajustá los valores.

# Carpeta donde se guardan los PDF y PNG generados
MOSAICO_OUTPUT_DIR=./output

# Nivel de log: DEBUG, INFO, WARNING o ERROR
MOSAICO_LOG_LEVEL=INFO

# Tamaño máximo de imagen subida, en MB (1 a 200)
MOSAICO_MAX_UPLOAD_MB=20

# Papel por defecto: A4, LETTER, A3 o TABLOID
MOSAICO_DEFAULT_PAPER=A4
